{
  "name": "@estamora/app",
  "version": "0.1.0",
  "private": true,
  "description": "The Estamora web application: presents conformance evidence for live Soroban testnet contracts, and validates every report it displays against the published normative schema.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "verify": "npm run verify:report && npm run check:browser-fetchable",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "verify:report": "tsx scripts/verify-committed-report.ts",
    "check:browser-fetchable": "tsx scripts/check-browser-fetchable.ts",
    "ci": "npm run format:check && npm run typecheck && npm run test:coverage && npm run build",
    "check:claims": "./scripts/check-claims.sh",
    "check:licences": "tsx scripts/check-licences.ts",
    "check:workflows": "tsx scripts/check-workflows.ts",
    "check:readme-links": "tsx scripts/check-readme-links.ts"
  },
  "keywords": [
    "stellar",
    "soroban",
    "conformance",
    "explorer",
    "vercel"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Estamora-Soroban-Layers/estamora-app.git"
  },
  "bugs": {
    "url": "https://github.com/Estamora-Soroban-Layers/estamora-app/issues"
  },
  "homepage": "https://estamora-app.vercel.app",
  "dependencies": {
    "@stellar/stellar-sdk": "17.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.0.1",
    "prettier": "3.9.7",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
